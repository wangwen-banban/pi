{
  "maxConcurrent": 4,
  "maxRecentJobs": 8,
  "router": {
    "enabled": true,
    "model": "openai-codex/gpt-5.6-luna",
    "effort": "low",
    "maxConversationChars": 24000,
    "maxSummaryChars": 6000
  },
  "context": {
    "maxFullChars": 40000,
    "maxSelectedChars": 12000,
    "selectedMessages": 6
  },
  "execution": {
    "hardTimeoutMs": 1800000,
    "terminateGraceMs": 5000,
    "workerExtensions": [
      "codex-multi-account",
      "provider-routing"
    ]
  },
  "modelProfiles": {
    "defaultTier": "B",
    "models": {
      "openai-codex/gpt-5.6-sol": {
        "tier": "S",
        "note": "最强推理，高风险/复杂任务"
      },
      "openai-codex/gpt-5.6-terra": {
        "tier": "B",
        "note": "日常编码与评审，平衡能力和额度"
      },
      "openai-codex/gpt-5.6-luna": {
        "tier": "C",
        "note": "轻量快速，简单任务和路由省额度"
      },
      "opencode-go/deepseek-v4-flash": {
        "tier": "C",
        "note": "日常主力，便宜快速"
      }
    }
  },
  "routes": {
    "simple": {
      "models": [
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-5.3-codex-spark",
        "$current"
      ],
      "effort": "low",
      "context": "isolated"
    },
    "medium": {
      "models": [
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-5.6-terra",
        "$current"
      ],
      "effort": "medium",
      "context": "selected"
    },
    "complex": {
      "models": [
        "openai-codex/gpt-5.6-sol",
        "openai-codex/gpt-5.6-terra",
        "$current"
      ],
      "effort": "max",
      "context": "summary"
    },
    "critical": {
      "models": [
        "openai-codex/gpt-5.6-sol",
        "$current"
      ],
      "effort": "max",
      "context": "summary"
    }
  },
  "hooks": {
    "started": [],
    "progress": [],
    "completed": [],
    "failed": [],
    "stopped": []
  }
}
